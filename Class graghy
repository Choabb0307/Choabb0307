<script>
  const slides = document.querySelectorAll('.slide');
  const total = slides.length;
  let current = 0, isAnimating = false;

  function startDeck() {
    document.getElementById('cover').classList.add('gone');
    try { if (document.documentElement.requestFullscreen) document.documentElement.requestFullscreen().catch(()=>{}); } catch(e){}
    setTimeout(() => {
      document.getElementById('deck').classList.add('active');
      document.getElementById('nav').classList.add('show');
      document.getElementById('progress').classList.add('show');
      document.getElementById('slide-label').classList.add('show');
      document.getElementById('hint').classList.add('show');
      updateUI();
      setTimeout(() => document.getElementById('hint').classList.remove('show'), 4000);
    }, 420);
  }

  function goTo(idx) {
    if (isAnimating || idx === current || idx < 0 || idx >= total) return;
    isAnimating = true;
    const dir = idx > current ? 1 : -1;
    const oldS = slides[current], newS = slides[idx];
    oldS.style.cssText += `transform:translateX(${-60*dir}px);opacity:0;`;
    oldS.classList.remove('active');
    newS.style.cssText += `transform:translateX(${60*dir}px);opacity:0;`;
    newS.classList.add('active');
    requestAnimationFrame(() => requestAnimationFrame(() => {
      newS.style.transform = 'translateX(0)';
      newS.style.opacity = '1';
    }));
    current = idx; updateUI();
    setTimeout(() => { oldS.style.cssText = ''; isAnimating = false; }, 580);
  }

  function navigate(dir) { goTo(current + dir); }

  function updateUI() {
    document.getElementById('counter').textContent = `${current+1} / ${total}`;
    document.getElementById('progress-bar').style.width = `${((current+1)/total)*100}%`;
    document.getElementById('slide-label').textContent = slides[current].dataset.label || '';
    document.getElementById('prevBtn').style.opacity = current === 0 ? '0.3' : '1';
    document.getElementById('nextBtn').style.opacity = current === total-1 ? '0.3' : '1';
  }

  document.addEventListener('keydown', e => {
    if (e.key==='ArrowRight'||e.key==='ArrowDown') navigate(1);
    if (e.key==='ArrowLeft'||e.key==='ArrowUp') navigate(-1);
    if (e.key==='Escape'&&document.fullscreenElement) document.exitFullscreen();
  });
  let tx=0;
  document.addEventListener('touchstart', e => { tx=e.touches[0].clientX; }, {passive:true});
  document.addEventListener('touchend', e => {
    const dx = e.changedTouches[0].clientX - tx;
    if (Math.abs(dx)>50) navigate(dx<0?1:-1);
  }, {passive:true});

  updateUI();
</script>
